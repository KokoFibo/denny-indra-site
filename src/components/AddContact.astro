---
import Layout from '../layouts/Layout.astro';
import { CONTACT, waLink } from '../config';
import { ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].contact;

const rows = [
  { icon: 'person', label: t.name, value: CONTACT.displayName },
  { icon: 'work', label: t.jobTitle, value: CONTACT.title },
  { icon: 'apartment', label: t.company, value: CONTACT.org },
  { icon: 'call', label: t.phone, value: CONTACT.phoneDisplay },
  { icon: 'mail', label: t.email, value: CONTACT.email },
];
---
<Layout route="contact" title={t.title} description={t.desc}>
  <section class="relative w-full bg-surface py-12 lg:py-20 overflow-hidden">
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[420px] h-[420px] rounded-full bg-tertiary-fixed/40 blur-3xl pointer-events-none"></div>
    <div class="max-w-2xl mx-auto px-6 relative z-10">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm uppercase tracking-wider mb-4">
          <span class="material-symbols-outlined text-sm">contact_page</span>
          <span>{t.badge}</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface font-bold mb-3">{t.h1}</h1>
        <p class="font-body-md text-body-md text-secondary" set:html={t.intro} />
      </div>

      <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/40 overflow-hidden">
        <div class="flex items-center gap-4 p-6 bg-surface-container-low">
          <img src="/logo-light.png" alt={t.logoAlt} width="64" height="65" class="h-16 w-16 object-contain dark:hidden" />
          <img src="/logo-dark.png" alt={t.logoAlt} width="64" height="65" class="hidden h-16 w-16 object-contain dark:block" />
          <div>
            <div class="font-headline-sm text-headline-sm text-on-surface font-semibold">{CONTACT.displayName}</div>
            <div class="font-body-sm text-body-sm text-secondary">{CONTACT.org}</div>
          </div>
        </div>

        <ul class="divide-y divide-outline-variant/30" data-stagger>
          {rows.map((r) => (
            <li class="flex items-start gap-4 px-6 py-4">
              <span class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                <span class="material-symbols-outlined text-xl">{r.icon}</span>
              </span>
              <div class="min-w-0">
                <div class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">{r.label}</div>
                <div class="font-body-md text-body-md text-on-surface break-words">{r.value}</div>
              </div>
            </li>
          ))}
        </ul>

        <div class="p-6 flex flex-col gap-3 bg-surface-container-low">
          <a href="/denny-indra.vcf" download="Denny_Indra.vcf" class="inline-flex items-center justify-center gap-2 h-12 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-label-lg text-label-lg transition-all shadow-sm">
            <span class="material-symbols-outlined text-xl">person_add</span>
            <span>{t.save}</span>
          </a>
          <div class="grid grid-cols-2 gap-3">
            <a href={waLink(ui[lang].waDefault)} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 h-11 rounded-lg bg-[#128C7E] hover:bg-[#0f766b] text-white font-label-md text-label-md transition-colors">
              <span class="material-symbols-outlined text-lg">chat</span><span>{ui[lang].whatsapp}</span>
            </a>
            <a href={`tel:${CONTACT.phone}`} class="inline-flex items-center justify-center gap-2 h-11 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors">
              <span class="material-symbols-outlined text-lg">call</span><span>{t.call}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
