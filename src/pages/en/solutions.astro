<!-- Inline Filtering & Calculator Logic -->

<script is:inline>
// Filter tabs behavior
  const filterBtns = document.querySelectorAll('#productFilterButtons .filter-tab');
  const productCards = document.querySelectorAll('#productCardContainer .product-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // update active button styles
      filterBtns.forEach(b => {
        b.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
        b.classList.add('bg-surface-container', 'text-secondary');
      });
      btn.classList.remove('bg-surface-container', 'text-secondary');
      btn.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');

      const filterVal = btn.getAttribute('data-filter');

      productCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filterVal === 'all' || cat === filterVal) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Dynamic Protection Calculator
  const expenseSlider = document.getElementById('expenseSlider');
  const calcExpenseDisplay = document.getElementById('calcExpenseDisplay');
  const calcResultDisplay = document.getElementById('calcResultDisplay');

  if (expenseSlider && calcExpenseDisplay && calcResultDisplay) {
    expenseSlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      const monthly = val * 1000000;
      // Formula: 10 years of annual expense = monthly * 12 * 10
      const recommendedCover = monthly * 120;
      
      calcExpenseDisplay.innerText = 'Rp ' + monthly.toLocaleString('en-US');
      calcResultDisplay.innerText = 'Rp ' + recommendedCover.toLocaleString('en-US');
    });
  }
</script>
