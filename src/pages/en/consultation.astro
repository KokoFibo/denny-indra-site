<script is:inline>
(function initAdvisoryCalculator() {
    // DOM Elements
    const expenseSlider = document.getElementById('expenseSlider');
    const legacySlider = document.getElementById('legacySlider');
    const expenseDisplay = document.getElementById('expenseValDisplay');
    const legacyDisplay = document.getElementById('legacyValDisplay');
    const resultUP = document.getElementById('resultUP');
    const resultPlafon = document.getElementById('resultPlafon');
    const resultPremi = document.getElementById('resultPremi');
    const childButtons = document.querySelectorAll('.child-btn');

    let currentChildren = 2;

    function formatRupiah(num) {
      return 'Rp ' + (num).toLocaleString('en-US');
    }

    function calculateValues() {
      if (!expenseSlider || !legacySlider) return;
      const expense = parseInt(expenseSlider.value, 10);
      const legacyTarget = parseInt(legacySlider.value, 10);

      // Display inputs
      expenseDisplay.textContent = formatRupiah(expense);
      if (legacyTarget >= 1000000000) {
        const inBillion = (legacyTarget / 1000000000).toFixed(0);
        legacyDisplay.textContent = 'Rp ' + inBillion + ' Billion';
      } else {
        legacyDisplay.textContent = formatRupiah(legacyTarget);
      }

      // Calculations:
      // UP Jiwa = (Annual Expense * 10 years multiplier) + (Children Education Reserve * currentChildren) + Legacy
      const annualExpense = expense * 12;
      const incomeReplacementUP = annualExpense * (currentChildren > 1 ? 12 : 10);
      const childReserve = currentChildren * 500000000;
      const totalUP = incomeReplacementUP + childReserve + legacyTarget;

      const upInBillion = (totalUP / 1000000000).toFixed(1);
      resultUP.textContent = 'Rp ' + upInBillion + ' Billion';

      // Hospitalization limit tier based on expense profile
      if (expense >= 50000000) {
        resultPlafon.textContent = 'Rp 65 Billion';
      } else if (expense >= 25000000) {
        resultPlafon.textContent = 'Rp 35 Billion';
      } else {
        resultPlafon.textContent = 'Rp 20 Billion';
      }

      // Monthly recommended allocation (approx 7% - 10% of monthly income/expense)
      const approxPremiMin = Math.round((expense * 0.08) / 100000) * 100000;
      resultPremi.textContent = '~ ' + formatRupiah(approxPremiMin) + ' /mo';
    }

    // Attach slider listeners
    if (expenseSlider) {
      expenseSlider.addEventListener('input', calculateValues);
    }
    if (legacySlider) {
      legacySlider.addEventListener('input', calculateValues);
    }

    // Child button listeners
    childButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        childButtons.forEach(b => {
          b.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
          b.classList.add('bg-surface-container', 'text-secondary');
        });
        btn.classList.remove('bg-surface-container', 'text-secondary');
        btn.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');
        currentChildren = parseInt(btn.getAttribute('data-val') || '0', 10);
        calculateValues();
      });
    });

    // Set default date picker to tomorrow
    const dateInput = document.getElementById('bookingDateInput');
    if (dateInput) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      dateInput.value = tomorrow.toISOString().split('T')[0];
      dateInput.min = tomorrow.toISOString().split('T')[0];
    }

    // Initialize display calculation
    calculateValues();

        // Kirim reservasi lewat WhatsApp
    window.handleBookingSubmit = function() {
      var WA = '6287860000788';
      var val = function (id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; };
      var modeEl = document.querySelector('input[name="meetingMode"]:checked');
      var modeLabel = { office: 'In person at the office', zoom: 'Video call (Zoom)', coffee: 'Coffee meeting' }[modeEl ? modeEl.value : ''] || '-';
      var slotSel = document.getElementById('bookingSlotSelect');
      var slot = slotSel ? slotSel.options[slotSel.selectedIndex].text : '-';
      var topics = Array.prototype.map.call(document.querySelectorAll('input[name="focusTopic"]:checked'), function (i) {
        return i.nextElementSibling ? i.nextElementSibling.textContent.trim() : '';
      }).filter(Boolean).join(', ') || '-';
      var msg = 'Hello Mr. Denny Indra, I would like to book a consultation.'
        + '\nName: ' + val('clientNameInput')
        + '\nWhatsApp: ' + val('clientWhatsappInput')
        + '\nCity: ' + val('clientCityInput')
        + '\nFormat: ' + modeLabel
        + '\nDate: ' + val('bookingDateInput') + ', ' + slot
        + '\nTopics: ' + topics;
      window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(msg), '_blank', 'noopener');
      var notice = document.getElementById('bookingSuccessNotice');
      if (notice) {
        notice.classList.remove('hidden');
        notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };
  })();
</script>
</Layout>
