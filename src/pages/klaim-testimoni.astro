---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
---
<Layout route="klaim" title={'Pendampingan Klaim & Testimoni | Denny Indra'} description={'Alur pendampingan klaim, testimoni klien, dan jawaban pertanyaan umum seputar klaim asuransi.'}>
<div class="flex flex-col w-full">
<!-- SECTION 1: EDITORIAL HEADER & HIGH-IMPACT METRICS -->
<section class="relative w-full px-6 lg:px-12 py-12 lg:py-16 overflow-hidden">
<div class="max-w-7xl mx-auto flex flex-col gap-12">
<!-- Top Eyebrow & Badging -->
<div class="flex flex-wrap items-center justify-between gap-4">
<div class="flex items-center gap-3">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-sm text-label-sm uppercase tracking-wider font-semibold">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Layanan Prioritas Klaim 24/7
          </span>
<span class="font-label-md text-label-md text-secondary">Protokol Penyelamatan Polis &amp; Fasilitas Eksekutif</span>
</div>
<div class="hidden sm:flex items-center gap-2 text-secondary font-label-sm text-label-sm tracking-widest uppercase">
<span>Prudential Executive Advisory</span>
<span>/</span>
<span class="text-primary font-semibold">MDRT Claim Desk</span>
</div>
</div>
<!-- Hero Headline Bento Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
<div class="lg:col-span-8 flex flex-col gap-6">
<h1 class="font-display text-display text-on-surface tracking-tight leading-[1.08]">
            Komitmen Nyata di Saat Krisis: <span class="text-primary italic font-normal">Pendampingan Klaim</span> Cepat, Tuntas, &amp; Bermartabat.
          </h1>
<p class="font-body-lg text-body-lg text-secondary max-w-2xl leading-relaxed">
            Asuransi diuji bukan saat premi dibayarkan, melainkan saat musibah kesehatan tiba. Denny Indra mendampingi setiap tahap administrasi, komunikasi tim medis, hingga klaim selesai tanpa membebani pikiran keluarga Anda.
          </p>
</div>
<!-- Quick Access VIP Emergency Pill Card -->
<div class="lg:col-span-4 flex flex-col gap-4">
<div class="p-6 rounded-xl bg-surface-container-lowest shadow-md flex flex-col gap-4">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-primary uppercase font-bold tracking-wider">Akses Langsung Darurat</span>
<span class="material-symbols-outlined text-primary text-xl" style="font-variation-settings: 'FILL' 1;">medical_services</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-on-surface font-semibold">Sedang di Rumah Sakit?</span>
<span class="font-body-sm text-body-sm text-secondary mt-1">Jangan tanda tangani penolakan atau bayar deposit tunai sebelum terhubung dengan meja klaim kami.</span>
</div>
<div class="pt-2 flex flex-col gap-2">
<a class="w-full py-3 px-4 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md flex items-center justify-center gap-2 shadow-xs hover:opacity-95 transition-all" href="https://wa.me/6287860000788?text=Halo%20Denny,%20saya%20membutuhkan%20bantuan%20klaim%20darurat%20sekarang" target="_blank">
<span class="material-symbols-outlined text-lg">chat</span>
                Buka Notifikasi Klaim Cepat
              </a>
</div>
</div>
</div>
</div>
<!-- Trust Metrics Ribbon (Bento Strip) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
<!-- Metric 1 -->
<div class="p-8 rounded-xl bg-surface-container-low flex flex-col justify-between gap-4">
<div class="flex items-center justify-between text-secondary">
<span class="font-label-sm text-label-sm tracking-widest uppercase font-semibold">Total Klaim Terbantu</span>
<span class="material-symbols-outlined text-primary">verified_user</span>
</div>
<div class="flex flex-col">
<span class="font-display text-display text-on-surface font-bold tracking-tight">Rp 45.8 <span class="font-headline-md text-headline-md text-primary">Miliar</span></span>
<span class="font-body-sm text-body-sm text-secondary mt-1">Realisasi santunan medis, sakit kritis, dan transfer warisan terverifikasi sejak 2014.</span>
</div>
