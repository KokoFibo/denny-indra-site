<div class="flex items-center justify-between">
<span class="w-10 h-10 rounded-full bg-primary text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold">4</span>
<span class="material-symbols-outlined text-primary text-2xl">task_alt</span>
</div>
<div class="flex flex-col gap-1">
<h3 class="font-headline-sm text-headline-sm text-on-surface">Penyelesaian Tuntas</h3>
