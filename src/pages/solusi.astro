</div>
</div>
<!-- Quick Interactive Category Filter Navigation -->
<div class="pt-8">
<div class="flex items-center justify-between gap-4 flex-wrap">
<div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="productFilterButtons">
<button class="filter-tab px-5 py-2.5 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md shadow-xs transition-all flex items-center gap-2" data-filter="all">
